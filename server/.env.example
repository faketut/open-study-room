# Copy to .env (gitignored). For docker-compose dev these defaults match the
# bundled `livekit-server --dev` instance.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
PORT=8787
DB_PATH=./data/syncle.db
TOKEN_TTL_SECONDS=3600
LOG_LEVEL=info
# Per-IP rate limit for POST /v1/sessions. Lower in production if abuse appears.
SESSION_RATE_LIMIT_MAX=30
SESSION_RATE_LIMIT_WINDOW_MS=60000

# ---- P1-B lightweight login (docs/contracts.md "Identity & login") ----
# GitHub OAuth. Both set => GitHub login on; either missing => off
# (503 github_not_configured, hidden from /v1/auth/config).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public server origin, e.g. https://study.example.com. Required when any
# login provider is on (builds redirect_uri + magic-link URLs).
BASE_URL=
# Where auth callbacks 302 the browser (token in the #token= fragment).
WEB_BASE_URL=http://localhost:8080
# SMTP for email magic links. SMTP_HOST + SMTP_FROM set => email login on;
# otherwise 501 email_not_configured (web hides the entry).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Site-level admin allowlist (comma-separated; GitHub logins case-insensitive,
# emails lowercased). Evaluated server-side; authenticated accounts only.
ADMIN_GITHUB_USERS=
ADMIN_EMAILS=
# Login-session lifetime (the bearer in #token=), in days.
LOGIN_SESSION_TTL_DAYS=30
# Per-IP rate limit for /v1/auth/*, separate from the sessions limiter.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

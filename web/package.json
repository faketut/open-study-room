{
  "name": "open-study-room-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open Study Room web client. Connects to the same LiveKit room + Open Study Room backend (server/).",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "sync-words": "node scripts/sync-moderation-words.mjs",
    "predev": "npm run sync-assets && npm run sync-words",
    "prebuild": "npm run sync-assets && npm run sync-words",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postbuild": "node scripts/assert-wb-lazy.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "livekit-client": "^2.5.7",
    "lucide-react": "^1.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.8"
  }
}
